helmDefaults:
  wait: true
  timeout: 600
  kubeContext: infomaniak
repositories:
  - name: kyverno
    url: https://kyverno.github.io/kyverno/
  - name: traefik
    url: https://helm.traefik.io/traefik
  - name: jetstack
    url: https://charts.jetstack.io

releases:
  #Kyverno Admission
  - name: kyverno
    namespace: kyverno
    createNamespace: true
    installed: true
    chart: kyverno/kyverno

  #cert-manager (installiert die cert-manager-CRDs)
  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: ./charts/cert-manager

  #ClusterIssuer (Let's Encrypt staging+prod) — eigenes Release NACH cert-manager,
  #damit die CRDs beim Installieren der Issuers schon existieren
  - name: cluster-issuers
    namespace: cert-manager
    chart: ./charts/cluster-issuers
    # E-Mail fuer Let's Encrypt kommt aus ADMIN_MAIL — geladen aus .env:
    #   set -a; source .env; set +a; helmfile apply ...
    # requiredEnv bricht ab, wenn ADMIN_MAIL nicht gesetzt ist (kein Fallback hier,
    # die Mail-Adresse steht nur in .env). Templating geht nur in der .gotmpl!
    values:
      - clusterIssuers:
          - name: letsencrypt-staging
            enabled: true
            server: https://acme-staging-v02.api.letsencrypt.org/directory
            email: {{ requiredEnv "ADMIN_MAIL" | quote }}
            ingressClass: traefik
          - name: letsencrypt-prod
            enabled: true
            server: https://acme-v02.api.letsencrypt.org/directory
            email: {{ requiredEnv "ADMIN_MAIL" | quote }}
            ingressClass: traefik

  #Traefik Ingress-Controller (LoadBalancer-Service bekommt bei Infomaniak automatisch eine oeffentliche Floating IP)
  - name: traefik
    namespace: traefik
    createNamespace: true
    chart: ./charts/traefik

  #metzler.systems cluster policys
  - name: kyverno-policies
    namespace: kyverno
    createNamespace: true
    chart: ./charts/kyverno-policies

  #Die Webseite
  - name: website
    namespace: website
    createNamespace: true
    chart: ./charts/website
