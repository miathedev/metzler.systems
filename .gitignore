# Secrets
.env

# Lokale Tools (z.B. Auto-Install von gitleaks durch pre-commit.sh)
/.bin/

# Lokale dev-Zertifikate (mkcert-CA und Certs aus dev/setup.sh) — nie committen
dev/certs/
# Vorheriger kubectl-Kontext, den dev/teardown.sh wiederherstellt
dev/.prev-context
# Marker: /etc/hosts-Eintrag wurde von dev/setup.sh gesetzt und darf von
# dev/teardown.sh wieder entfernt werden
dev/.hosts-added
# Von dev/setup.sh geschriebener HTTPS-Port (dev-image.sh meldet URLs damit)
dev/.https-port
# Keine Binaerartefakte im Repo: vendored chart deps werden ignoriert.
# Flux nutzt fuer Upstream-Charts direkt HelmRepositories (siehe flux/cluster/infomaniak/),
# lokale Charts ohne Deps kommen als Git-Source.
charts/*/charts/

# Editor / OS
.DS_Store
*.swp
*.bak
*.tmp
*.orig
*~
.idea/
# VSCode: alles lokal ignorieren, außer den geteilten Workspace-Dateien
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Logs
*.log

# Python
__pycache__/
*.pyc
.ruff_cache/
# Coverage-Artefakte der pytest-Läufe (dev/run-tests.sh mit --cov)
.coverage

# Hugo (site/)
site/public/
site/resources/
site/hugo_stats.json
site/.hugo_build.lock
site/node_modules/
site/assets/dist/
# Auto-generierte JS-Config (Pfade zeigen in den lokalen Hugo-Modulcache,
# stimmen auf CI/Docker nicht) — wird von Hugo selbst nicht gelesen, nur Editor.
site/assets/jsconfig.json

