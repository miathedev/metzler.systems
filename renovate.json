{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "docker"
      ],
      "pinDigests": true,
      "commitMessageTopic": "digest-pin"
    },
    {
      "matchDepNames": [
        "gohugoio/hugo"
      ],
      "commitMessageTopic": "hugo",
      "automerge": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "minimumReleaseAge": "14 days",
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "minimumReleaseAge": "14 days",
      "automerge": true
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "14 days",
      "automerge": true
    }
  ]
}
